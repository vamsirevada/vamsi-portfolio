# GitHub personal access token used to fetch the contribution graph
# server-side (app/api/github-contributions/route.js).
#
# Create one at https://github.com/settings/tokens
#   - Classic token → scope: read:user (that's the only scope needed)
#   - Fine-grained token → Account permissions → "Read access to profile"
#
# Copy this file to .env.local and paste the token in. Add the same
# variable in your deployment host's project settings (e.g. Vercel →
# Project → Settings → Environment Variables) so it works in production too.
GITHUB_TOKEN=

# Resend API key used to send the contact form (app/api/contact/route.js).
#
# Sign up at https://resend.com, create an API key, and paste it below.
# Without a verified sending domain, mail sends from onboarding@resend.dev,
# which works fine for delivery but isn't branded. Once you verify your own
# domain in the Resend dashboard, set CONTACT_FROM_EMAIL below to something
# like "Vamsi Revada <hello@vamsirevada.com>".
#
# Copy this file to .env.local and paste the key in. Add the same variables
# in your deployment host's project settings (e.g. Vercel → Project →
# Settings → Environment Variables) so the form works in production too.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
