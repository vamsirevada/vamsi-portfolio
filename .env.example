# GitHub personal access token used to fetch the contribution graph
# server-side (app/api/github-contributions/route.js).
#
# Create one at https://github.com/settings/tokens
#   - Classic token → scope: read:user (that's the only scope needed)
#   - Fine-grained token → Account permissions → "Read access to profile"
#
# Copy this file to .env.local and paste the token in. Add the same
# variable in your deployment host's project settings (e.g. Vercel →
# Project → Settings → Environment Variables) so it works in production too.
GITHUB_TOKEN=

# Resend API key used to send the contact form (app/api/contact/route.js).
#
# Sign up at https://resend.com, create an API key, and paste it below.
# Without a verified sending domain, mail sends from onboarding@resend.dev,
# which works fine for delivery but isn't branded. Once you verify your own
# domain in the Resend dashboard, set CONTACT_FROM_EMAIL below to something
# like "Vamsi Revada <hello@vamsirevada.com>".
#
# Copy this file to .env.local and paste the key in. Add the same variables
# in your deployment host's project settings (e.g. Vercel → Project →
# Settings → Environment Variables) so the form works in production too.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# --- Private invoice tool (app/invoice) ---
# A password-gated page (not linked anywhere public) for generating and
# emailing client invoices during freelance projects. See README.md →
# "Invoice tool" for full setup steps.

# Password to unlock /invoice. Required — without it the page always
# redirects to a locked-out login screen.
INVOICE_PASSWORD=

# Used to sign the login session cookie. Optional — falls back to
# INVOICE_PASSWORD if unset, but setting a separate long random value here
# is better practice (so the session secret isn't the same string as the
# password itself).
INVOICE_SESSION_SECRET=

# Postgres connection string for storing invoice history (invoice numbers,
# client details, amounts, status). Get one for free via Vercel → Storage →
# Create Database → Postgres (powered by Neon) — it injects DATABASE_URL
# automatically once linked to this project. Without it, /invoice shows a
# "not configured" message instead of erroring.
DATABASE_URL=

# Your business details, shown on every generated invoice PDF. All optional
# except the name; blank fields are simply omitted from the PDF.
INVOICE_BUSINESS_NAME=
INVOICE_BUSINESS_EMAIL=
INVOICE_BUSINESS_ADDRESS=
INVOICE_BUSINESS_PHONE=
INVOICE_GST_NUMBER=

# Payment instructions shown in the PDF footer. INVOICE_BANK_DETAILS can be
# multi-line free text (account name/number/IFSC/bank name, etc).
INVOICE_BANK_DETAILS=
INVOICE_UPI_ID=
INVOICE_PAYPAL_EMAIL=
